# Copy to .env (chmod 600). ./run.sh setup fills RELAY_TOKEN / BDK_TOKEN with random values if empty.
# Never commit .env.

# --- Cursor / Grok Bot ---------------------------------------------------------
# Cursor API key of the account that owns your Grok Bots (Cursor dashboard → API keys).
CURSOR_API_KEY=
# Bot opened by default (must be a name in bots.json). Empty = first entry in bots.json.
DEFAULT_BOT=

# --- Relay -----------------------------------------------------------------------
# Public HTTPS URL of the relay (no trailing slash). Baked into the app and its network whitelist by ./run.sh build.
#   Tailscale Funnel: https://<machine>.<tailnet>.ts.net     Cloudflare: https://g2.example.com
RELAY_PUBLIC_URL=https://your-relay.example.com
RELAY_PORT=8787
# Shared secret the phone app sends as "Authorization: Bearer …". Hand it out with ./run.sh pair, never paste it around.
RELAY_TOKEN=
# Local bdk serve (127.0.0.1 only)
BDK_PORT=3100
BDK_TOKEN=
# Optional overrides
# BOTS_FILE=./bots.json
# DATA_DIR=./data
# APP_PACKAGE_ID=com.example.grokbotg2      # your own reverse-DNS id for the Even Hub package
# NODE_BIN_DIR=/opt/node-22/bin            # if the system node is older than 22.13

# --- Tunnel ----------------------------------------------------------------------
# tailscale-funnel | cloudflare | none   (none = you run your own HTTPS reverse proxy)
TUNNEL_MODE=tailscale-funnel
# Tailscale (uses the `tailscale` CLI; Funnel must be allowed for the node in your tailnet policy)
# TAILSCALE_BIN=tailscale
# TAILSCALE_SUDO=1                          # run the CLI via sudo -n
# TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
# For hosts without a system tailscaled (e.g. containers), let run.sh start one:
# TAILSCALED_BIN=/opt/tailscale/tailscaled
# TAILSCALE_STATE_DIR=/opt/tailscale/state   # --statedir is required for Funnel HTTPS certs
# TAILSCALED_FLAGS=--tun=userspace-networking
# Cloudflare named tunnel (quick tunnels are NOT suitable: their URL changes every run)
# CLOUDFLARE_TUNNEL_TOKEN=                   # dashboard-managed tunnel (route its public hostname to http://127.0.0.1:8787)
# CLOUDFLARE_TUNNEL=grokbot-g2               # or a locally-managed tunnel name
# CLOUDFLARED_BIN=cloudflared

# --- Speech-to-text ------------------------------------------------------------
# elevenlabs | whisper | none
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# STT_MODEL=scribe_v1
# ELEVENLABS_ENV_FILE=/path/to/other/.env     # read ELEVENLABS_API_KEY from an existing env file instead
# whisper.cpp (local, free): build https://github.com/ggml-org/whisper.cpp and download a ggml model
# WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper.cpp/models/ggml-base.bin

# --- Avatars (tools/avatars.py, run by ./run.sh build) ----------------------------
# Drop <BotName>.png|jpg|webp into avatars-src/ to use your own pictures; otherwise bots.json shape/colour or a monogram.
# AVATAR_SRC_DIR=./avatars-src
# AGENTS_DIR=                                 # optional folder of per-agent dirs (<id>/avatar.*, <id>/profile.json)
